---
import Layout from '@components/Layout.astro';
import { collaborationRoutes, leadershipHighlights } from '@data/profile';
---
<Layout
  title="Advising"
  description="Research collaboration, academic leadership, and invited talks."
>
  <section class="section page-title">
    <h1>Research leadership and collaboration</h1>
    <p class="lead">
      Three routes for research participation, collective-level collaboration, and direct
      academic enquiries.
    </p>
  </section>

  <section class="section collaboration-routes" aria-label="Collaboration routes">
    {collaborationRoutes.map((route) => (
      <article>
        <h2>{route.title}</h2>
        <p>{route.summary}</p>
        <a
          href={route.href}
          target={route.external ? '_blank' : undefined}
          rel={route.external ? 'noopener noreferrer' : undefined}
        >
          {route.linkLabel}
        </a>
      </article>
    ))}
  </section>

  <section class="section split-section leadership-section">
    <div>
      <h2>Selected academic roles</h2>
      <p>Graduate programme, institute, and interdisciplinary research leadership.</p>
    </div>
    <ul class="role-list">
      {leadershipHighlights.map((item) => (
        <li>
          <strong>{item.role}</strong>
          <span>{item.organization}</span>
          {item.period && <span class="role-period">{item.period}</span>}
        </li>
      ))}
    </ul>
  </section>
</Layout>

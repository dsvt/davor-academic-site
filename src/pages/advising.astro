---
import Layout from '@components/Layout.astro';
import { advisingTopics, leadershipHighlights } from '@data/profile';
---
<Layout
  title="Advising"
  description="Research collaboration, academic leadership, and invited talks."
>
  <section class="section page-title">
    <p class="eyebrow">Advising and collaboration</p>
    <h1>Research leadership and collaboration</h1>
    <p class="lead">
      Areas for graduate supervision, joint research, academic program work, and invited talks.
    </p>
  </section>

  <section class="section topic-grid advising-grid">
    {advisingTopics.map((topic) => (
      <article class="topic-summary">
        <h2>{topic.title}</h2>
        <p>{topic.summary}</p>
        <ul>
          {topic.examples.map((example) => <li>{example}</li>)}
        </ul>
      </article>
    ))}
  </section>

  <section class="section split-section leadership-section">
    <div>
      <p class="eyebrow">Leadership</p>
      <h2>Selected academic roles</h2>
    </div>
    <ul class="role-list">
      {leadershipHighlights.map((item) => (
        <li>
          <strong>{item.role}</strong>
          <span>{item.organization}</span>
          {item.period && <span class="role-period">{item.period}</span>}
        </li>
      ))}
    </ul>
  </section>

  <section class="section contact-prompt">
    <h2>Start a conversation</h2>
    <p>For research, academic, or speaking enquiries, use the public contact route.</p>
    <a href="/contact">Contact and profiles</a>
  </section>
</Layout>

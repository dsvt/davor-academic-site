---
import ExternalLink from '@components/ExternalLink.astro';
import Layout from '@components/Layout.astro';
import { currentTheme, foundationThemes, trustLab } from '@data/profile';
---
<Layout
  title="Research"
  description="Research on agentic AI security, decentralized systems, and cyber-physical resilience."
>
  <section class="section page-title">
    <h1>Research</h1>
    <p class="lead">
      Davor's work asks how autonomous systems can be trusted when they act across code, markets,
      and physical infrastructure. It builds on long-running work in blockchain, cyber-physical
      security, and software engineering.
    </p>
  </section>

  <section class="section programme-section" id={currentTheme.slug}>
    <div class="programme-statement">
      <p class="research-context">Current programme</p>
      <h2>{currentTheme.title}</h2>
      <p>
        Autonomous agents increasingly act across model services, smart contracts, digital markets,
        and physical infrastructure. The research question is direct: how can these systems be
        audited, constrained, and kept resilient under adversarial conditions?
      </p>
      <p>
        The programme runs at {trustLab.shortName}, where its research themes, people, and outputs
        are kept up to date.
      </p>
    </div>
    <ul class="programme-topics programme-links">
      <li><ExternalLink href={`${trustLab.href}/research`}>Research themes</ExternalLink></li>
      <li><ExternalLink href={`${trustLab.href}/people`}>People</ExternalLink></li>
      <li><ExternalLink href={`${trustLab.href}/work`}>Projects and outputs</ExternalLink></li>
      <li><ExternalLink href={`${trustLab.href}/news`}>Lab news</ExternalLink></li>
    </ul>
  </section>

  <section class="section foundations-section">
    <header>
      <h2>Research foundations</h2>
      <p>
        The current agentic-systems programme builds on three longer lines of research.
      </p>
    </header>
    <div class="research-ledger">
      {foundationThemes.map((theme) => (
        <article id={theme.slug}>
          <h3>{theme.title}</h3>
          <p>{theme.summary}</p>
          <ul>
            {theme.topics.map((topic) => <li>{topic}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>
</Layout>

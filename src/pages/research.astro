---
import Layout from '@components/Layout.astro';
import { researchInitiatives, researchThemes } from '@data/profile';

const currentTheme = researchThemes[0];
const supportingThemes = researchThemes.slice(1);
const trustLab = researchInitiatives.find((initiative) => initiative.shortName === 'Trust Lab');
---
<Layout
  title="Research"
  description="Research on agentic AI security, decentralized systems, and cyber-physical resilience."
>
  <section class="section page-title">
    <h1>Agentic AI security and resilient systems</h1>
    <p class="lead">
      The current program connects autonomous-agent security with long-running work on blockchain,
      cyber-physical systems, and software engineering.
    </p>
  </section>

  <section class="section programme-section" id={currentTheme.slug}>
    <div class="programme-statement">
      <p class="research-context">Current programme</p>
      <h2>{currentTheme.title}</h2>
      <p>
        Autonomous agents increasingly act across model services, smart contracts, digital markets,
        and physical infrastructure. The research question is direct: how can these systems be
        audited, constrained, and kept resilient under adversarial conditions?
      </p>
      {trustLab && (
        <a href={`${trustLab.href}/research`} target="_blank" rel="noopener noreferrer">
          Read the full programme at Trust Lab
        </a>
      )}
    </div>
    <ul class="programme-topics">
      {currentTheme.topics.map((topic) => <li>{topic}</li>)}
    </ul>
  </section>

  <section class="section foundations-section">
    <header>
      <h2>Research foundations</h2>
      <p>
        The current agentic-systems programme builds on three longer lines of research.
      </p>
    </header>
    <div class="research-ledger">
      {supportingThemes.map((theme) => (
        <article id={theme.slug}>
          <h3>{theme.title}</h3>
          <p>{theme.summary}</p>
          <ul>
            {theme.topics.map((topic) => <li>{topic}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>
</Layout>

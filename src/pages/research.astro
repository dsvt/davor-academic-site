---
import Layout from '@components/Layout.astro';
import { profile } from '@data/profile';
---
<Layout title="Research" description="Research areas and themes for Davor Svetinovic.">
  <section class="section page-title">
    <p class="eyebrow">Research</p>
    <h1>Research areas</h1>
    <p class="lead">A compact map of current and historical research themes.</p>
  </section>

  <section class="section grid-two">
    {profile.researchAreas.map((area) => (
      <article class="content-card">
        <h2>{area}</h2>
        <p>Replace this paragraph with a concise 80-120 word description, representative projects, and links to selected papers.</p>
      </article>
    ))}
  </section>
</Layout>

---
import Layout from '@components/Layout.astro';
import { researchThemes } from '@data/profile';
---
<Layout title="Research" description="Research themes for Davor Svetinovic.">
  <section class="section page-title">
    <p class="eyebrow">Research</p>
    <h1>Research themes</h1>
    <p class="lead">
      A concise map of public research threads across blockchain systems, cybersecurity,
      secure AI, and software engineering.
    </p>
  </section>

  <section class="section grid-two">
    {researchThemes.map((theme) => (
      <article class="content-card">
        <h2>{theme.title}</h2>
        <p>{theme.summary}</p>
        <ul>
          {theme.topics.map((topic) => <li>{topic}</li>)}
        </ul>
      </article>
    ))}
  </section>
</Layout>

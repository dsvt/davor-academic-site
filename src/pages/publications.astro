---
import Layout from '@components/Layout.astro';
import PublicationList from '@components/PublicationList.astro';
import { profile } from '@data/profile';
import { publicationsByYear } from '@data/publications';
---
<Layout title="Publications" description="Selected publications by Davor Svetinovic.">
  <section class="section page-title">
    <p class="eyebrow">Publications</p>
    <h1>Selected publications</h1>
    <p class="lead">
      A short selected list. For the full publication record, use Google Scholar.
    </p>
    <p><a href={profile.scholarUrl} target="_blank" rel="noopener noreferrer">View all publications on Google Scholar</a></p>
  </section>

  <section class="section">
    <h2>Selected publications</h2>
    <PublicationList publications={publicationsByYear} />
  </section>
</Layout>

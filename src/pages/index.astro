---
import Layout from '@components/Layout.astro';
import ProfileLinks from '@components/ProfileLinks.astro';
import PublicationList from '@components/PublicationList.astro';
import { advisingTopics, profile, researchThemes } from '@data/profile';
import { publicationsByYear } from '@data/publications';

const featuredPublications = publicationsByYear.slice(0, 4);
---
<Layout title={profile.name} description={profile.tagline}>
  <section class="hero section">
    <div class="hero-copy">
      <p class="eyebrow">{profile.location}</p>
      <h1>{profile.name}</h1>
      <p class="lead">{profile.title}</p>
      <p>{profile.tagline}</p>
      <ProfileLinks />
    </div>
    <figure class="hero-photo">
      <img src={profile.photo.src} alt={profile.photo.alt} width="480" height="343" />
    </figure>
  </section>

  <section class="section grid-two">
    <div>
      <h2>About</h2>
      <p>{profile.shortBio}</p>
      {profile.longBio.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div class="content-card">
      <h2>Research focus</h2>
      <ul>
        {researchThemes.map((theme) => <li>{theme.title}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>Selected publications</h2>
      <div class="link-row">
        <a href="/publications">View selected publications</a>
        <a href={profile.scholarUrl} target="_blank" rel="noopener noreferrer">Google Scholar for full list</a>
      </div>
    </div>
    <PublicationList publications={featuredPublications} />
  </section>

  <section class="section grid-three">
    {advisingTopics.map((topic) => (
      <article class="mini-card">
        <h2>{topic.title}</h2>
        <p>{topic.summary}</p>
      </article>
    ))}
  </section>
</Layout>

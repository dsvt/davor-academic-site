---
import Layout from '@components/Layout.astro';
import ProfileLinks from '@components/ProfileLinks.astro';
import PublicationList from '@components/PublicationList.astro';
import {
  leadershipHighlights,
  profile,
  researchInitiatives,
  researchThemes
} from '@data/profile';
import { publicationsByYear } from '@data/publications';

const featuredPublications = publicationsByYear.filter((publication) => publication.featured);
const currentTheme = researchThemes[0];
const supportingThemes = researchThemes.slice(1);
const trustLab = researchInitiatives.find((initiative) => initiative.shortName === 'Trust Lab');
---
<Layout title={profile.name} description={profile.tagline}>
  <section class="hero section" aria-labelledby="hero-title">
    <figure class="hero-photo">
      <img
        src={profile.photo.src}
        alt={profile.photo.alt}
        width="932"
        height="667"
        fetchpriority="high"
      />
    </figure>
    <div class="hero-copy">
      <h1 id="hero-title">{profile.name}</h1>
      <p class="hero-statement">{profile.tagline}</p>
      <div class="hero-record">
        <p>{profile.title}<br />{profile.location}</p>
        <ProfileLinks primaryOnly />
      </div>
    </div>
  </section>

  <section class="section split-section profile-section">
    <div class="prose-block">
      <h2>About</h2>
      <p>{profile.shortBio}</p>
      {profile.longBio.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div class="leadership-block">
      <h2>Selected leadership</h2>
      <ul class="role-list">
        {leadershipHighlights.map((item) => (
          <li>
            <strong>{item.role}</strong>
            <span>{item.organization}</span>
            {item.period && <span class="role-period">{item.period}</span>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section initiatives-section">
    <div class="initiatives-intro">
      <h2>Current research initiatives</h2>
      <p>
        REQS Labs provides the collective structure. Trust Lab carries the active programme,
        people, methods, and public research record.
      </p>
    </div>
    <div class="initiative-ledger">
      {researchInitiatives.map((initiative) => (
        <article>
          <p class="initiative-role">{initiative.role}</p>
          <h3>{initiative.name}</h3>
          <p>{initiative.summary}</p>
          <a href={initiative.href} target="_blank" rel="noopener noreferrer">
            Visit {initiative.shortName}
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="section research-index">
    <article class="research-feature" id={currentTheme.slug}>
      <p class="research-context">Current programme</p>
      <h2>{currentTheme.title}</h2>
      <p>{currentTheme.summary}</p>
      <div class="link-row research-links">
        <a href={`/research#${currentTheme.slug}`}>Research overview</a>
        {trustLab && (
          <a href={`${trustLab.href}/research`} target="_blank" rel="noopener noreferrer">
            Programme at Trust Lab
          </a>
        )}
      </div>
    </article>
    <div class="research-foundations">
      <h2>Research foundations</h2>
      {supportingThemes.map((theme) => (
        <article>
          <h3><a href={`/research#${theme.slug}`}>{theme.title}</a></h3>
          <p>{theme.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section publications-home">
    <div class="section-heading">
      <h2>Selected work</h2>
      <div class="link-row">
        <a href="/publications">Selected publications</a>
        <a href={profile.scholarUrl} target="_blank" rel="noopener noreferrer">
          Full list on Google Scholar
        </a>
      </div>
    </div>
    <PublicationList publications={featuredPublications} />
  </section>
</Layout>

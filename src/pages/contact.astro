---
import Layout from '@components/Layout.astro';
import ProfileLinks from '@components/ProfileLinks.astro';
import { profile } from '@data/profile';

const linkedin = profile.links.find((link) => link.label === 'LinkedIn');
const xProfile = profile.links.find((link) => link.label === 'X');
---
<Layout title="Contact" description="Contact Davor Svetinovic and view academic profiles.">
  <section class="section page-title">
    <p class="eyebrow">Contact</p>
    <h1>Contact</h1>
    <p class="lead">
      For research collaboration, invited talks, and academic enquiries, use LinkedIn or X.
    </p>
  </section>

  <section class="section contact-layout">
    <div class="contact-primary">
      <h2>Research and academic enquiries</h2>
      <p>Include a short note about the topic, institution, and expected form of collaboration.</p>
      <div class="contact-links">
        {linkedin && (
          <a class="primary-link" href={linkedin.href} target="_blank" rel="noopener noreferrer">
            LinkedIn
          </a>
        )}
        {xProfile && (
          <a class="primary-link" href={xProfile.href} target="_blank" rel="noopener noreferrer">
            X
          </a>
        )}
      </div>
    </div>
    <div class="profiles-block">
      <h2>Academic profiles</h2>
      <ProfileLinks academicOnly />
    </div>
  </section>
</Layout>

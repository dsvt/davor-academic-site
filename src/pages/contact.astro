---
import ExternalLink from '@components/ExternalLink.astro';
import Layout from '@components/Layout.astro';
import ProfileLinks from '@components/ProfileLinks.astro';
import { profile } from '@data/profile';

const socialLinks = profile.links.filter((link) => link.kind === 'social');
const socialLabels = new Intl.ListFormat('en', { type: 'disjunction' }).format(
  socialLinks.map((link) => link.label)
);
---
<Layout title="Contact" description="Contact Davor Svetinovic and view academic profiles.">
  <section class="section page-title">
    <h1>Contact</h1>
    <p class="lead">
      For research collaboration, invited talks, and academic enquiries, use {socialLabels}.
    </p>
  </section>

  <section class="section contact-layout">
    <div class="contact-primary">
      <h2>Research and academic enquiries</h2>
      <p>Include a short note about the topic, institution, and expected form of collaboration.</p>
      <div class="contact-links">
        {socialLinks.map((link) => (
          <ExternalLink class="primary-link" href={link.href}>{link.label}</ExternalLink>
        ))}
      </div>
    </div>
    <div class="profiles-block">
      <h2>Academic profiles</h2>
      <ProfileLinks academicOnly />
    </div>
  </section>
</Layout>

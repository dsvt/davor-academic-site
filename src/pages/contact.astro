---
import Layout from '@components/Layout.astro';
import ProfileLinks from '@components/ProfileLinks.astro';
---
<Layout title="Contact" description="Contact and external profiles.">
  <section class="section page-title">
    <p class="eyebrow">Contact</p>
    <h1>Contact and profiles</h1>
    <p class="lead">
      Public profile links for publications, professional background, and academic contact.
    </p>
  </section>

  <section class="section content-card">
    <h2>External profiles</h2>
    <ProfileLinks />
    <p>
      For publication records, start with DBLP, ORCID, or Google Scholar. For professional context
      and direct outreach, use LinkedIn or another public profile listed here.
    </p>
  </section>
</Layout>

---
import { profile } from '@data/profile';

type Props = {
  primaryOnly?: boolean;
  academicOnly?: boolean;
};

const { primaryOnly = false, academicOnly = false } = Astro.props;
const links = profile.links.filter((link) => {
  if (primaryOnly) return link.primary;
  if (academicOnly) return link.label !== 'LinkedIn' && link.label !== 'X';
  return true;
});
---
<div class="profile-links" aria-label="External profiles">
  {links.map((link) => (
    <a
      href={link.href}
      rel="me noopener noreferrer"
      target="_blank"
      aria-label={`${link.label} (opens in a new tab)`}
    >
      {link.label}
    </a>
  ))}
</div>

---
import ExternalLink from '@components/ExternalLink.astro';
import { profile } from '@data/profile';

type Props = {
  primaryOnly?: boolean;
  academicOnly?: boolean;
};

const { primaryOnly = false, academicOnly = false } = Astro.props;
const links = profile.links.filter((link) => {
  if (primaryOnly) return link.primary;
  if (academicOnly) return link.kind === 'academic';
  return true;
});
---
<nav class="profile-links" aria-label="External profiles">
  <ul>
    {links.map((link) => (
      <li>
        <ExternalLink href={link.href} me>{link.label}</ExternalLink>
      </li>
    ))}
  </ul>
</nav>

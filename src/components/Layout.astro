---
import { navigation } from '@data/navigation';
import { profile, researchInitiatives } from '@data/profile';
import '@styles/global.css';

type Props = {
  title?: string;
  description?: string;
};

const {
  title = profile.name,
  description = profile.tagline
} = Astro.props;

const pageTitle = title === profile.name ? profile.name : `${title} | ${profile.name}`;
const canonicalPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonical = new URL(canonicalPath, profile.canonicalUrl).toString();
const socialImage = new URL(profile.photo.src, profile.canonicalUrl).toString();
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: profile.canonicalUrl,
  image: socialImage,
  jobTitle: 'Computer Science Professor and Associate Chair for Graduate Studies',
  affiliation: [
    { '@type': 'Organization', name: 'Khalifa University' },
    { '@type': 'Organization', name: 'ADIA Lab' }
  ],
  sameAs: profile.links.map((link) => link.href),
  memberOf: researchInitiatives.map((initiative) => ({
    '@type': 'ResearchProject',
    name: initiative.name,
    url: initiative.href
  }))
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={profile.photo.alt} />
    <meta property="og:site_name" content={profile.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/">{profile.name}</a>
        <div class="nav-links">
          {navigation.map((item) => (
            <a href={item.href} aria-current={canonicalPath === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </div>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p>© {new Date().getFullYear()} {profile.name}.</p>
        <nav aria-label="Research initiatives">
          {researchInitiatives.map((initiative) => (
            <a href={initiative.href} target="_blank" rel="noopener noreferrer">
              {initiative.shortName}
            </a>
          ))}
        </nav>
      </div>
    </footer>
  </body>
</html>

---
import { navigation } from '@data/navigation';
import { profile } from '@data/profile';
import '@styles/global.css';

type Props = {
  title?: string;
  description?: string;
};

const {
  title = profile.name,
  description = profile.tagline
} = Astro.props;

const pageTitle = title === profile.name ? profile.name : `${title} | ${profile.name}`;
const canonicalPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonical = new URL(canonicalPath, profile.canonicalUrl).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/">{profile.name}</a>
        <div class="nav-links">
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        © {new Date().getFullYear()} {profile.name}.
      </p>
    </footer>
  </body>
</html>
